{
  "features": [
    "distance_m",
    "projection_ratio",
    "projection_distance_m",
    "arc_length_m",
    "heading_difference_rad",
    "heading_cosine",
    "speed_mps",
    "dt_s",
    "from_in_degree",
    "from_out_degree",
    "to_in_degree",
    "to_out_degree",
    "motion_valid",
    "time_valid"
